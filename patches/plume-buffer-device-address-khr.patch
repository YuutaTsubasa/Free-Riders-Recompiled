 // - Fix resource pools.
 
 namespace plume {
+    // A Vulkan 1.1 device that has VK_KHR_buffer_device_address (required below)
+    // gives the function only under its extension name. The pointers volk loads
+    // from the instance are never null (the loader's trampolines), yet the core
+    // one jumps to address 0 on such a device (an Adreno 730 driver), so the
+    // device's own entry point is taken once it exists, by its API version.
+    static PFN_vkGetBufferDeviceAddress bufferDeviceAddressFunction = nullptr;
+    static const char *bufferDeviceAddressName = "none";
+
+    static void loadBufferDeviceAddress(VkDevice device, uint32_t apiVersion) {
+        bufferDeviceAddressFunction = nullptr;
+        bufferDeviceAddressName = "none";
+        const char *names[] = { (apiVersion >= VK_API_VERSION_1_2) ? "vkGetBufferDeviceAddress" : nullptr, "vkGetBufferDeviceAddressKHR" };
+        for (const char *name : names) {
+            if (name == nullptr) {
+                continue;
+            }
+
+            bufferDeviceAddressFunction = reinterpret_cast<PFN_vkGetBufferDeviceAddress>(vkGetDeviceProcAddr(device, name));
+            if (bufferDeviceAddressFunction != nullptr) {
+                bufferDeviceAddressName = name;
+                return;
+            }
+        }
+    }
+
+    static VkDeviceAddress getBufferDeviceAddress(VkDevice device, const VkBufferDeviceAddressInfo *info) {
+        return bufferDeviceAddressFunction(device, info);
+    }
+
+    const char *VulkanDevice::bufferDeviceAddressEntryPoint() {
+        return bufferDeviceAddressName;
+    }
