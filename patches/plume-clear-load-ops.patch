+    bool VulkanCommandList::foldsClear(const RenderRect *clearRects, uint32_t clearRectsCount) const {
+        if (!queue->device->foldClearsIntoLoadOps || (activeRenderPass != VK_NULL_HANDLE) || (targetFramebuffer == nullptr)) {
+            return false;
+        }
+
+        if (clearRectsCount == 0) {
+            return true;
+        }
+
+        // Rectangles that cover the whole framebuffer (a pass clears all of it).
+        for (uint32_t i = 0; i < clearRectsCount; i++) {
+            const RenderRect &rect = clearRects[i];
+            if ((rect.left <= 0) && (rect.top <= 0) && (rect.right >= int32_t(targetFramebuffer->width)) && (rect.bottom >= int32_t(targetFramebuffer->height))) {
+                return true;
+            }
+        }
+
+        return false;
     }
 
