+    VkRenderPass VulkanFramebuffer::getClearRenderPass(uint32_t clearMask) const {
+        std::lock_guard<std::mutex> lock(clearPassMutex);
+        auto found = clearPasses.find(clearMask);
+        if (found != clearPasses.end()) {
+            return found->second;
+        }
+
+        // Only the load operations differ, so the pass stays compatible with
+        // renderPass: the framebuffer and every pipeline made for it work.
+        std::vector<VkAttachmentDescription> attachments = attachmentDescriptions;
+        for (uint32_t i = 0; i < uint32_t(colorReferences.size()); i++) {
+            if (clearMask & (1u << i)) {
+                attachments[colorReferences[i].attachment].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            }
+        }
+
+        if (hasDepthStencil) {
+            VkAttachmentDescription &depth = attachments[depthReference.attachment];
+            if (clearMask & ClearDepthBit) {
+                depth.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            }
+
+            if (clearMask & ClearStencilBit) {
+                depth.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            }
+        }
+
+        VkSubpassDescription subpass = {};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.pColorAttachments = !colorReferences.empty() ? colorReferences.data() : nullptr;
+        subpass.colorAttachmentCount = uint32_t(colorReferences.size());
+        subpass.pDepthStencilAttachment = hasDepthStencil ? &depthReference : nullptr;
+
+        VkRenderPassCreateInfo passInfo = {};
+        passInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+        passInfo.pAttachments = attachments.data();
+        passInfo.attachmentCount = uint32_t(attachments.size());
+        passInfo.pSubpasses = &subpass;
+        passInfo.subpassCount = 1;
+
+        VkRenderPass clearPass = VK_NULL_HANDLE;
+        VkResult res = vkCreateRenderPass(device->vk, &passInfo, nullptr, &clearPass);
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreateRenderPass failed with error code 0x%X.\n", res);
+            clearPass = VK_NULL_HANDLE;
+        }
+
+        clearPasses[clearMask] = clearPass;
+        return clearPass;
     }
 
