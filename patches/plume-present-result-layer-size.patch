     // MARK: - CocoaWindow
 
+    // The CAMetalLayer drawn into (a Metal view's, such as SDL's) in the window's views.
+    static CAMetalLayer *findMetalLayer(NSView *view, int depth) {
+        if ([view.layer isKindOfClass:CAMetalLayer.class]) {
+            return (CAMetalLayer *)view.layer;
+        }
+
+        if (depth <= 0) {
+            return nil;
+        }
+
+        for (NSView *child in view.subviews) {
+            if (CAMetalLayer *layer = findMetalLayer(child, depth - 1)) {
+                return layer;
+            }
+        }
+
+        return nil;
+    }
+
+    // The window's size in pixels. With a Metal layer in it, the layer's own size in pixels
+    // (bounds times contents scale, truncated): the size MoltenVK holds the swap chain to.
+    // The window's backing scale differs from the layer's when the view is not high
+    // resolution (a Retina or scaled display), and a swap chain of the window's size then
+    // made every present suboptimal.
+    static CocoaWindowAttributes readWindowAttributes(NSWindow *nsWindow) {
+        NSRect contentFrame = [[nsWindow contentView] frame];
+        CocoaWindowAttributes attributes;
+        attributes.x = (int)round(contentFrame.origin.x);
+        attributes.y = (int)round(contentFrame.origin.y);
+
+        CAMetalLayer *layer = findMetalLayer([nsWindow contentView], 4);
+        if ((layer != nil) && (layer.bounds.size.width >= 1.0) && (layer.bounds.size.height >= 1.0)) {
+            const CGFloat layerScale = layer.contentsScale;
+            attributes.width = (int)trunc(layer.bounds.size.width * layerScale);
+            attributes.height = (int)trunc(layer.bounds.size.height * layerScale);
+            return attributes;
+        }
+
+        CGFloat scaleFactor = [nsWindow backingScaleFactor];
+        attributes.width = (int)round(contentFrame.size.width * scaleFactor);
+        attributes.height = (int)round(contentFrame.size.height * scaleFactor);
+        return attributes;
+    }
