        d = min(d, label_stroke(p, float2(0.4300, 1.0000), float2(0.5500, 0.8800)));
        d = min(d, label_stroke(p, float2(0.5500, 0.8800), float2(0.5500, 0.6000)));
        d = min(d, label_stroke(p, float2(0.5500, 0.6000), float2(0.4300, 0.4800)));
    }
    else if (digit == 9) {
        d = min(d, label_stroke(p, float2(0.0500, 0.9500), float2(0.1500, 1.0000)));
        d = min(d, label_stroke(p, float2(0.1500, 1.0000), float2(0.4000, 1.0000)));
        d = min(d, label_stroke(p, float2(0.4000, 1.0000), float2(0.5500, 0.8500)));
        d = min(d, label_stroke(p, float2(0.5500, 0.8500), float2(0.5500, 0.1200)));
        d = min(d, label_stroke(p, float2(0.5500, 0.1200), float2(0.4300, 0.0000)));
        d = min(d, label_stroke(p, float2(0.4300, 0.0000), float2(0.1200, 0.0000)));
        d = min(d, label_stroke(p, float2(0.1200, 0.0000), float2(0.0000, 0.1200)));
        d = min(d, label_stroke(p, float2(0.0000, 0.1200), float2(0.0000, 0.4000)));
        d = min(d, label_stroke(p, float2(0.0000, 0.4000), float2(0.1200, 0.5200)));
        d = min(d, label_stroke(p, float2(0.1200, 0.5200), float2(0.4300, 0.5200)));
        d = min(d, label_stroke(p, float2(0.4300, 0.5200), float2(0.5500, 0.4200)));
    }
    return d - 0.0900;
}

// Distance from p to "FPS".
float readout_suffix(float2 p) {
    float d = 1.0e4;
    d = min(d, label_stroke(p, float2(0.5000, 0.0000), float2(0.0000, 0.0000)));
    d = min(d, label_stroke(p, float2(0.0000, 0.0000), float2(0.0000, 1.0000)));
    d = min(d, label_stroke(p, float2(0.0000, 0.4800), float2(0.4000, 0.4800)));
    d = min(d, label_stroke(p, float2(0.8000, 1.0000), float2(0.8000, 0.0000)));
    d = min(d, label_stroke(p, float2(0.8000, 0.0000), float2(1.2300, 0.0000)));
    d = min(d, label_stroke(p, float2(1.2300, 0.0000), float2(1.3800, 0.1200)));
    d = min(d, label_stroke(p, float2(1.3800, 0.1200), float2(1.3800, 0.4000)));
    d = min(d, label_stroke(p, float2(1.3800, 0.4000), float2(1.2300, 0.5200)));
    d = min(d, label_stroke(p, float2(1.2300, 0.5200), float2(0.8000, 0.5200)));
    d = min(d, label_stroke(p, float2(2.2600, 0.1300), float2(2.1300, 0.0000)));
    d = min(d, label_stroke(p, float2(2.1300, 0.0000), float2(1.8300, 0.0000)));
    d = min(d, label_stroke(p, float2(1.8300, 0.0000), float2(1.7000, 0.1200)));
    d = min(d, label_stroke(p, float2(1.7000, 0.1200), float2(1.7000, 0.3500)));
    d = min(d, label_stroke(p, float2(1.7000, 0.3500), float2(1.8200, 0.4600)));
    d = min(d, label_stroke(p, float2(1.8200, 0.4600), float2(2.1400, 0.5400)));
    d = min(d, label_stroke(p, float2(2.1400, 0.5400), float2(2.2800, 0.6500)));
    d = min(d, label_stroke(p, float2(2.2800, 0.6500), float2(2.2800, 0.8800)));
    d = min(d, label_stroke(p, float2(2.2800, 0.8800), float2(2.1500, 1.0000)));
    d = min(d, label_stroke(p, float2(2.1500, 1.0000), float2(1.8200, 1.0000)));
    d = min(d, label_stroke(p, float2(1.8200, 1.0000), float2(1.6800, 0.8700)));
    return d - 0.0900;
}
