        d = min(d, label_stroke(p, float2(0.4300, 0.0000), float2(0.5500, 0.1200)));
        d = min(d, label_stroke(p, float2(0.5500, 0.1200), float2(0.5500, 0.3800)));
        d = min(d, label_stroke(p, float2(0.5500, 0.3800), float2(0.0000, 1.0000)));
        d = min(d, label_stroke(p, float2(0.0000, 1.0000), float2(0.5500, 1.0000)));
    }
    else if (digit == 3) {
        d = min(d, label_stroke(p, float2(0.0000, 0.1000), float2(0.1000, 0.0000)));
        d = min(d, label_stroke(p, float2(0.1000, 0.0000), float2(0.4500, 0.0000)));
