// The frame-rate readout (fps_readout.h), in cap heights from its upper left
// corner: digits every g_ReadoutAdvance, then a space and "FPS".
static const float g_ReadoutAdvance = 0.8500;
static const float g_ReadoutSpace = 0.5500;
static const float g_ReadoutSuffixWidth = 2.2800;
static const uint g_ReadoutMax = 999;

// Distance from p to a digit (negative inside).
float readout_digit(uint digit, float2 p) {
    float d = 1.0e4;
    if (digit == 0) {
        d = min(d, label_stroke(p, float2(0.1200, 0.0000), float2(0.4300, 0.0000)));
        d = min(d, label_stroke(p, float2(0.4300, 0.0000), float2(0.5500, 0.1200)));
