        d = min(d, label_stroke(p, float2(0.4300, 1.0000), float2(0.1200, 1.0000)));
        d = min(d, label_stroke(p, float2(0.1200, 1.0000), float2(0.0000, 0.8800)));
        d = min(d, label_stroke(p, float2(0.0000, 0.8800), float2(0.0000, 0.1200)));
        d = min(d, label_stroke(p, float2(0.0000, 0.1200), float2(0.1200, 0.0000)));
    }
    else if (digit == 1) {
        d = min(d, label_stroke(p, float2(0.0800, 0.2000), float2(0.3000, 0.0000)));
        d = min(d, label_stroke(p, float2(0.3000, 0.0000), float2(0.3000, 1.0000)));
        d = min(d, label_stroke(p, float2(0.0800, 1.0000), float2(0.5200, 1.0000)));
