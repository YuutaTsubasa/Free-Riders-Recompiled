// Generated by tests/touch_labels_test.cpp --write from src/touch_labels.cpp: do not edit.
// The on-screen buttons' names as round-ended strokes (touch_labels.h), in
// button radii from the circle's centre (or the knob's), y down.

float label_stroke(float2 p, float2 a, float2 b) {
    const float2 pa = p - a, ba = b - a;
    return length(pa - ba * saturate(dot(pa, ba) / dot(ba, ba)));
}

// Whether circle i's name rides on its stick's knob.
bool label_on_knob(int i) { return i == 0 || i == 10; }

// Distance from p to circle i's name (negative inside a stroke); i is a
